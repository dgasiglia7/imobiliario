# Modelo do arquivo de ambiente do serviço de leads.
#
# Na VPS, copie para `.env` na mesma pasta e preencha. O `.env` NÃO vai para o
# Git (ver ../.gitignore) e é lido pelo systemd — ver docs/DEPLOY.md, passo 8.
#
#   cp .env.example .env && chmod 600 .env && nano .env
#
# Formato do systemd: CHAVE=valor, sem aspas, sem espaço em volta do `=`.

# Porta local do serviço. Reservada em ../../infra/PORTAS.md — não mude sem
# atualizar o registro lá e o proxy_pass no nginx.
PORT=3006

# SMTP da Hostinger. 465 é TLS direto; use 587 se precisar de STARTTLS.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465

# A caixa que AUTENTICA e assina o envio.
SMTP_USER=contato@gasigliaadvocacia.com.br

# Senha de APLICATIVO, gerada no hPanel da caixa, não a senha de login.
# Ela aparece uma única vez na tela; se perder, gere outra e revogue esta.
SMTP_PASS=

# Remetente exibido. O endereço precisa ser o mesmo do SMTP_USER, senão o
# SPF do domínio não cobre o envio e o aviso cai no spam.
MAIL_FROM=Gasiglia Advocacia <contato@gasigliaadvocacia.com.br>

# Quem recebe o lead. Aceita vários, separados por vírgula.
MAIL_TO=contato@gasigliaadvocacia.com.br
